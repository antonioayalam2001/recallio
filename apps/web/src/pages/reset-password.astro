---
import Layout from '../presentation/layouts/Layout.astro';
import { ResetPasswordForm } from '../presentation/components/auth/ResetPasswordForm';

const token = Astro.url.searchParams.get('token');

// Si no hay token en la URL, podríamos redirigir o simplemente dejar que el form
// falle al enviar, pero es mejor mostrar un mensaje directo o redirigir al login.
---

<Layout title="Restablecer Contraseña">
  <ResetPasswordForm client:only="react" />
</Layout>
