---
import Layout from '../presentation/layouts/Layout.astro';
import { VocabularyView } from '../presentation/components/vocabulary/VocabularyView';
---

<Layout title="Catálogo de Vocabulario">
  <div class="mb-10">
    <h2 class="text-3xl font-black mb-2 text-primary">Diccionario</h2>
    <p class="opacity-80">Explora las palabras aprobadas o sugiere nuevas para hacer crecer la comunidad.</p>
  </div>
  
  <VocabularyView client:load />
</Layout>
