---
import { ViewTransitions } from 'astro:transitions';
import '../../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://localhost:3000 http://127.0.0.1:3000;">
		<meta name="description" content="Aprende vocabulario en inglés jugando" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions />
	</head>
	<body class="min-h-screen flex flex-col font-sans antialiased">
    <GlobalToaster client:load />
	</head>
	<body class="min-h-screen flex flex-col font-sans antialiased">
    <header class="w-full p-4 flex justify-between items-center bg-card shadow-sm relative z-50">
      <h1 class="text-xl font-bold text-primary">English Grammar 🇬🇧</h1>
      <nav class="flex gap-4 items-center" id="nav-menu">
        <a href="/" class="hover:underline font-semibold hidden auth-link">Jugar</a>
        <a href="/vocabulary" class="hover:underline font-semibold hidden auth-link">Vocabulario</a>
        <a href="/admin" class="hover:underline font-semibold hidden admin-link">Admin Panel</a>
        <a href="/auth" class="bg-primary/10 text-primary px-4 py-2 rounded-full font-bold hover:bg-primary hover:text-white transition-colors" id="auth-btn">Ingresar</a>
      </nav>
    </header>
		<main class="flex-1 w-full max-w-5xl mx-auto p-4 md:p-8">
			<slot />
		</main>

    <!-- Script de Protección de Rutas (Client-Side) -->
    <script>
      import { api } from '../../infrastructure/api';

      function checkAuth() {
        const isAuthenticated = localStorage.getItem('isAuthenticated');
        const role = localStorage.getItem('role'); 
        const currentPath = window.location.pathname;

        if (!isAuthenticated && currentPath !== '/auth') {
          window.location.href = '/auth';
          return;
        }

        if (isAuthenticated && role !== 'ADMIN' && currentPath === '/admin') {
          alert('No tienes permisos de administrador para acceder a esta ruta.');
          window.location.href = '/';
          return;
        }

        if (isAuthenticated && currentPath === '/auth') {
          window.location.href = '/';
          return;
        }

        if (isAuthenticated) {
          document.querySelectorAll('.auth-link').forEach(el => el.classList.remove('hidden'));
          
          if (role === 'ADMIN') {
            document.querySelectorAll('.admin-link').forEach(el => el.classList.remove('hidden'));
          }

          const authBtn = document.getElementById('auth-btn');
          if (authBtn) {
            authBtn.textContent = 'Cerrar Sesión';
            authBtn.href = '#';
            authBtn.onclick = async (e) => {
              e.preventDefault();
              try {
                await api.post('/auth/logout');
              } catch (e) {} // Ignorar errores en logout
              
              localStorage.removeItem('isAuthenticated');
              localStorage.removeItem('role');
              window.location.href = '/auth';
            };
          }
        }
      }

      document.addEventListener('astro:page-load', checkAuth);
    </script>
	</body>
</html>
