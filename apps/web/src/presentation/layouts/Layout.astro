---
import { ViewTransitions } from 'astro:transitions';
import 'sonner/dist/styles.css';
import '../../styles/global.css';
import { GlobalToaster } from '../components/ui/GlobalToaster';
import { Navbar } from '../components/ui/Navbar';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://localhost:3000 http://127.0.0.1:3000;">
		<meta name="description" content="Aprende vocabulario y estudia con Active Recall" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions />

    <!-- Script sin parpadeo (anti-FOUC) para sincronizar tema antes de renderizar -->
    <script is:inline>
      function applyTheme() {
        const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
	</head>
	<body class="min-h-screen flex flex-col font-sans antialiased ambient-glow overflow-x-hidden">
    <GlobalToaster client:load transition:persist="toaster" />
    
    <!-- Navbar Responsive Flotante (React Island persistente) -->
    <Navbar client:load transition:persist="navbar" />

		<main class="flex-1 w-full max-w-5xl mx-auto p-4 md:p-8 pt-6">
			<slot />
		</main>

    <!-- Script de Protección de Rutas (Client-Side) -->
    <script>
      function checkAuth() {
        const isAuthenticated = localStorage.getItem('isAuthenticated');
        const role = localStorage.getItem('role'); 
        const currentPath = window.location.pathname;

        const publicPaths = ['/auth', '/reset-password'];

        if (!isAuthenticated && !publicPaths.includes(currentPath)) {
          window.location.href = '/auth';
          return;
        }

        if (isAuthenticated && role !== 'ADMIN' && currentPath === '/admin') {
          alert('No tienes permisos de administrador para acceder a esta ruta.');
          window.location.href = '/';
          return;
        }

        if (isAuthenticated && publicPaths.includes(currentPath)) {
          window.location.href = '/';
          return;
        }
      }

      document.addEventListener('astro:page-load', checkAuth);
      checkAuth();
    </script>
	</body>
</html>
